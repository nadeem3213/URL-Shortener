<!DOCTYPE html>
<html lang="en">
<head>
    <style>

        body {
            background-color: floralwhite;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        h1 {
            margin-bottom: 24px;
            color: #333;
            font-size: 28px;
            letter-spacing: 0.5px;
        }

        form {
            display: flex;
            flex-direction: column;
            align-items: center;
            background: #fff;
            padding: 36px 40px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            width: 340px;
        }

        label {
            align-self: flex-start;
            margin-bottom: 6px;
            font-size: 14px;
            font-weight: 600;
            color: #555;
        }

        input[type="text"] {
            padding: 10px 14px;
            width: 100%;
            margin-bottom: 18px;
            border-radius: 6px;
            border: 1px solid #ccc;
            font-size: 15px;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }

        input[type="text"]:focus {
            outline: none;
            border-color: #007BFF;
            box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.15);
        }

        button {
            padding: 12px 0;
            width: 100%;
            background-color: #007BFF;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 8px;
            transition: background-color 0.2s, transform 0.1s;
        }

        button:hover {
            background-color: #0056b3;
        }

        button:active {
            transform: scale(0.98);
        }

        .error-box {
            width: 100%;
            background-color: #fff0f0;
            border: 1px solid #f5c6cb;
            color: #c0392b;
            padding: 10px 14px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 16px;
            text-align: center;
        }

    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
</head>
<body>
    <h1>Login Page</h1>
    <form action="/user/login" method="POST">
        <% if (locals.error) { %>
            <div class="error-box">⚠️ <%= error %></div>
        <% } %>
        <label>Email</label>
        <input type="text" required name="email"/>
        <label>Password</label>
        <input type="text" required name="password"/>
        
        <button type="submit">login</button>
        <div style="margin-top: 20px; font-size: 14px; color: #555; text-align: center;">
            If you haven't signed up, <br>
            <a href="/signup" style="display: inline-block; margin-top: 10px; color: #007BFF; font-weight: 600; text-decoration: none; border: 1px solid #007BFF; padding: 6px 12px; border-radius: 4px; transition: all 0.2s;">Sign Up Here</a>
        </div>
    </form>
</body>
</html>